frame_insets = [6, 12, 6, 12]
mode = "replace"

[[layers]]
id = "contents"
slot = "tile.contents.chrome"
art = "panel"
fit = "frame"
frame_insets = [6, 12, 6, 12]
mode = "replace"

[[layers]]
id = "vertical-mullion"
slot = "divider.vertical"
art = "vertical"
fit = "frame"
frame_insets = [0, 0, 0, 0]
mode = "replace"

[[layers]]
id = "horizontal-mullion"
slot = "divider.horizontal"
art = "horizontal"
fit = "frame"
frame_insets = [0, 0, 0, 0]
mode = "replace"

[[variants]]
when = { high_contrast = true }
hide_layers = ["architecture", "edit", "view", "filesystem", "contents", "vertical-mullion", "horizontal-mullion"]

[fallbacks.ascii]
glyph = "#"

[fallbacks.monochrome]
glyph = "."

[fallbacks.narrow]
glyph = "."
hide_layers = ["architecture", "edit", "view", "filesystem", "contents", "vertical-mullion", "horizontal-mullion"]

[fallbacks.reduced_motion]
glyph = "."
