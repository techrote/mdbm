# Geometry-fitted sculpted environment; requires MDBM frame-fit support.
# Shared upper-left light, connected corners, recessed openings and shaded mullions.
# Source: tests/build_solid_relief_themes.py. Data only; no runtime shaders.
schema = "md-editor-theme/1.1"
id = "intaglio-gunmetal"
name = "Intaglio / Gunmetal Diepress"
description = "Continuous gunmetal environment with 32 paired foreground/background tones."
seed = 73191
seed_mode = "fixed"
fps = 6

[palette]
paper = "#05080c"
ink = "#dee8ed"
muted = "#96a6b2"
frame = "#465462"
accent = "#c5d7e4"
code = "#c5d7e4"
link = "#b2d4c0"
secondary = "#c87957"
shadow = "#090807"
grime = "#34251c"
metal = "#93603b"
highlight = "#ffe0a3"
heading = "#c5d7e4"
warning = "#e5b96e"
error = "#ff938d"
success = "#9ac1b2"
cavity = "#655044"
side = "#ba8b68"
face = "#93603b"
light = "#ffe0a3"

[geometry]
outer = [2, 3, 2, 3]
border = 3
divider = 2
spacer = 0

