# Geometry-fitted sculpted environment; requires MDBM frame-fit support.
# Shared upper-left light, connected corners, recessed openings and shaded mullions.
# Source: tests/build_solid_relief_themes.py. Data only; no runtime shaders.
schema = "md-editor-theme/1.1"
id = "reliquary-amethyst"
name = "Reliquary / Amethyst Vault"
description = "Continuous amethyst environment with 32 paired foreground/background tones."
seed = 73191
seed_mode = "fixed"
fps = 6

[palette]
paper = "#09060e"
ink = "#e9dfef"
muted = "#9e76b7"
frame = "#513762"
accent = "#d0a4ed"
code = "#d0a4ed"
link = "#a9cddd"
secondary = "#c481b3"
shadow = "#05040a"
grime = "#292037"
metal = "#75618e"
highlight = "#f0e0ff"
heading = "#d0a4ed"
warning = "#e5b96e"
error = "#ff938d"
success = "#a6cbdc"
cavity = "#574569"
side = "#9d88b6"
face = "#75618e"
light = "#f0e0ff"

[geometry]
outer = [2, 3, 2, 3]
border = 3
divider = 2
spacer = 0

