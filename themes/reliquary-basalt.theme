# Geometry-fitted sculpted environment; requires MDBM frame-fit support.
# Shared upper-left light, connected corners, recessed openings and shaded mullions.
# Source: tests/build_solid_relief_themes.py. Data only; no runtime shaders.
schema = "md-editor-theme/1.1"
id = "reliquary-basalt"
name = "Reliquary / Basalt Crypt"
description = "Continuous basalt environment with 32 paired foreground/background tones."
seed = 73191
seed_mode = "fixed"
fps = 6

[palette]
paper = "#080909"
ink = "#e3dfd2"
muted = "#aba28d"
frame = "#514f48"
accent = "#d1bea0"
code = "#d1bea0"
link = "#a7c4bf"
secondary = "#c481b3"
shadow = "#05040a"
grime = "#292037"
metal = "#75618e"
highlight = "#f0e0ff"
heading = "#d1bea0"
warning = "#e5b96e"
error = "#ff938d"
success = "#a6cbdc"
cavity = "#574569"
side = "#9d88b6"
face = "#75618e"
light = "#f0e0ff"

[geometry]
outer = [2, 3, 2, 3]
border = 3
divider = 2
spacer = 0

