# Geometry-fitted sculpted environment; requires MDBM frame-fit support.
# Shared upper-left light, connected corners, recessed openings and shaded mullions.
# Source: tests/build_solid_relief_themes.py. Data only; no runtime shaders.
schema = "md-editor-theme/1.1"
id = "monolith-glacial"
name = "Monolith / Glacial Chamber"
description = "Continuous glacial environment with 32 paired foreground/background tones."
seed = 73191
seed_mode = "fixed"
fps = 6

[palette]
paper = "#040b16"
ink = "#dcecf2"
muted = "#6ab0ca"
frame = "#2b5972"
accent = "#a2e6fa"
code = "#a2e6fa"
link = "#c9c0ee"
secondary = "#799fe7"
shadow = "#040810"
grime = "#1b3047"
metal = "#5385aa"
highlight = "#edfcff"
heading = "#a2e6fa"
warning = "#e5b96e"
error = "#ff938d"
success = "#a4e3dc"
cavity = "#3f637b"
side = "#81aec7"
face = "#5385aa"
light = "#edfcff"

[geometry]
outer = [2, 3, 2, 3]
border = 3
divider = 2
spacer = 0

