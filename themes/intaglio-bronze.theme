# Geometry-fitted sculpted environment; requires MDBM frame-fit support.
# Shared upper-left light, connected corners, recessed openings and shaded mullions.
# Source: tests/build_solid_relief_themes.py. Data only; no runtime shaders.
schema = "md-editor-theme/1.1"
id = "intaglio-bronze"
name = "Intaglio / Bronze Housing"
description = "Continuous bronze environment with 32 paired foreground/background tones."
seed = 73191
seed_mode = "fixed"
fps = 6

[palette]
paper = "#080705"
ink = "#eddfca"
muted = "#c1844e"
frame = "#683e25"
accent = "#efb26f"
code = "#efb26f"
link = "#a9cdbb"
secondary = "#c87957"
shadow = "#090807"
grime = "#34251c"
metal = "#93603b"
highlight = "#ffe0a3"
heading = "#efb26f"
warning = "#e5b96e"
error = "#ff938d"
success = "#9ac1b2"
cavity = "#655044"
side = "#ba8b68"
face = "#93603b"
light = "#ffe0a3"

[geometry]
outer = [2, 3, 2, 3]
border = 3
divider = 2
spacer = 0

