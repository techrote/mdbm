# Original hand-drawn ASCII relief. Lighting: upper left; depth: down/right.
# No block glyphs, random face textures, animation, or executable content.
schema = "md-editor-theme/1.1"
id = "iron-intaglio"
name = "Iron Intaglio"
description = "Cast-iron die plate: machined lips, copper bevels, deep letter counters, ribbed webs and concentric lathe-cut bosses."
seed = 23117
seed_mode = "fixed"
fps = 6

[palette]
paper = "#15100e"
ink = "#e9d9c6"
muted = "#b7a08c"
frame = "#77503b"
accent = "#f2a45d"
code = "#dfc591"
link = "#9ac1b2"
secondary = "#c87957"
shadow = "#090807"
grime = "#34251c"
metal = "#93603b"
highlight = "#ffe0a3"
heading = "#f2a45d"
warning = "#e5b96e"
error = "#ff938d"
success = "#9ac1b2"
cavity = "#655044"
side = "#ba8b68"
face = "#93603b"
light = "#ffe0a3"

[geometry]
# Eight requested rows + four default user rows = twelve for the sculpture.
outer = [8, 2, 0, 2]
border = 1
divider = 1
spacer = 0

[styles.background]
fg = "ink"
bg = "paper"

[styles.text]
fg = "ink"
bg = "paper"

[styles.muted]
fg = "muted"
bg = "paper"

[styles.border]
fg = "frame"
bg = "paper"

[styles.title]
fg = "accent"
bg = "paper"
bold = true

[styles.accent]
fg = "accent"
bg = "paper"

[styles.code]
fg = "code"
bg = "paper"

[styles.heading]
fg = "heading"
bg = "paper"
bold = true

[styles.link]
fg = "link"
bg = "paper"
underline = true

[styles.quote]
fg = "secondary"
bg = "paper"
italic = true

[styles.table]
fg = "ink"
bg = "paper"

[styles.diagnostic]
fg = "warning"
bg = "paper"

[styles.tree]
fg = "ink"
bg = "paper"

[styles.gutter]
fg = "muted"
bg = "paper"

[styles.status]
fg = "muted"
bg = "paper"

[styles.keyword]
fg = "accent"
bg = "paper"
bold = true

[styles.string]
fg = "link"
bg = "paper"

[styles.number]
fg = "code"
bg = "paper"

[styles.comment]
fg = "muted"
bg = "paper"
italic = true

[styles.relief-outline]
fg = "side"
bg = "paper"

[styles.relief-light]
fg = "light"
bg = "paper"

[styles.relief-face]
fg = "accent"
bg = "paper"

[styles.relief-hatch]
fg = "face"
bg = "paper"

[styles.relief-cavity]
fg = "cavity"
bg = "paper"

[styles.relief-shadow]
fg = "shadow"
bg = "paper"

[styles.registration]
fg = "frame"
bg = "paper"

[styles.active]
fg = "accent"
bg = "paper"

[styles.attention]
fg = "warning"
bg = "paper"

[styles.saved]
fg = "success"
bg = "paper"

[styles.fault]
fg = "error"
bg = "paper"

[art.hero-outline]
rows = ["                                                                                                           ", "                                                                       |         +                    +    ", "                                                                         |                                |", "             |          |          |          |          |   ( )         |            +          +       | ", "|   | |  | |   | |  | | | | |  | |   | |     |  | |   |              |  |   | |                  | | |  |  ", "|   |      |   | |  | | | |      |   | | |   |   |      |    ( )     |  |   | |   | | ( () ) | |   | |     ", "|   | |  |     | |  | |   | | \\ \\|   | |  | |    | |     |           |      | |    \\  +    +       | |     ", "|   | |        |      |   | |  \\ \\   |      |    |       |            |       \\ \\                          "]
style = "relief-outline"

[art.hero-light]
rows = ["     ___________________________________________________________________           --------------------    ", "   /__________________________________________________________________/         - -------------------- -   ", "  /  _________  _________  _________  _________  _________             /        / /     ----------     / / ", " /  / ____  /  / ____  /  / ____  /  / ______/  / ______/             /       / /      ----------    / /   ", "     = __ = /   =    =   =   __ = /   =   ___ /  = ___ /                     =     / /  ----  / / =        ", "       ___/     =    =   =   _  /     =   _ /       ___/                     =     =          = /   =   /  ", "     _    /     = __ = /   =          = __ = /    = ____/               /    =         ----  / /    =  /   ", " ___ _ __/_____ ______ ___ _ __ _ ___ ______ ____ _______ /___________  /        ____ -------- ___/ / /    "]
style = "relief-light"

[art.hero-cavity]
rows = ["                                                                                                           ", "                                                                                                           ", "                                                                                                           ", "                                                                                                        %  ", "                  @@                                                                                  %%   ", "                  @@                                                                                  %%   ", "                                                                                                      %    ", "                                                                                                     %     "]
style = "relief-cavity"

[art.hero-hatch]
rows = ["                                                                                  .                    .   ", "                                                                               .                        .  ", "                                                                        :      .       .          .        ", "                                                                       ::            .            .        ", "                                                                      ::               .    .              ", "                                                                      ::                                   ", "       ::                                                             ::             `      .              ", "                                                                       :             `        .            "]
style = "relief-hatch"

[art.hero-face]
rows = ["                                                                                                           ", "                                                                                                           ", "                                                                                                           ", "                                                              o                                            ", "                                                                                                           ", "                                                              o                                            ", "                                                                                                           ", "                                                                                                           "]
style = "relief-face"

[art.hero-shadow]
rows = ["     ___________________________________________________________________           --------------------    ", "   /__________________________________________________________________/|        - -------------------- -   ", "  /  _________  _________  _________  _________  _________             / |      / /     ----------     / /|", " /  / ____  /| / ____  /| / ____  /| / ______/| / ______/|            /  |    / /      ----------    / / | ", "|   | |__| |/  | |  | | | | |__| |/  | |  ___|/ | |___|/             |  |   | |    / /  ----  / /| | |  |  ", "|   |  ___/|   | |  | | | |  _  /|   | | |_ /|   |  ___/|            |  |   | |   | |        | |/  | |  /  ", "|   |_|  |/    | |__| |/  | | \\ \\|   | |__| |/   | |____/|           |  /   | |    \\   ----  / /   | | /   ", "|___|_|__/_____|______|___|_|__\\_\\___|______|____|_______|/___________| /     \\ \\____ -------- ___/ / /    "]
style = "relief-shadow"

[art.pier-outline]
rows = ["      ", "     |", "|  | |", "|  |  ", "|  |  ", "|\\\\|  ", "|  |  ", "|  |  ", "      "]
style = "relief-outline"

[art.pier-light]
rows = ["  --- ", "/___/ ", "      ", " __  /", " // / ", "      ", " //   ", " __   ", "      "]
style = "relief-light"

[art.pier-cavity]
rows = ["      ", "      ", "      ", "      ", "      ", "      ", "      ", "      ", "      "]
style = "relief-cavity"

[art.pier-hatch]
rows = [" .   .", "      ", "    : ", "    : ", "      ", "      ", "      ", "      ", "  ..  "]
style = "relief-hatch"

[art.pier-face]
rows = ["      ", "      ", "  o   ", "      ", "      ", "      ", "      ", "      ", "      "]
style = "relief-face"

[art.pier-shadow]
rows = ["  --- ", "/___/|", "|  | |", "|__| /", "|//|/ ", "|\\\\|  ", "|//|  ", "|__|  ", "      "]
style = "relief-shadow"

[art.molding-outline]
rows = ["                      ", "     |       |       |", "|   |   |   |   |   | "]
style = "relief-outline"

[art.molding-light]
rows = [" ____    ____    ____ ", "/___/ __/___/ __/___/ ", " ___ /   ___ /   ___ /"]
style = "relief-light"

[art.molding-cavity]
rows = ["                      ", "                      ", "                      "]
style = "relief-cavity"

[art.molding-hatch]
rows = ["                      ", "                      ", "      ::      ::      "]
style = "relief-hatch"

[art.molding-face]
rows = ["                      ", "                      ", "                      "]
style = "relief-face"

[art.molding-shadow]
rows = [" ____    ____    ____ ", "/___/|__/___/|__/___/|", "|___|/  |___|/  |___|/"]
style = "relief-shadow"

[art.maker-mark]
rows = [":: IRON INTAGLIO / SCULPTED ASCII / MDBM ::"]
style = "registration"

[patterns.patina]
kind = "scatter"
glyphs = [".", ",", ":"]
period = [29, 11]
density = 0.018
style = "relief-cavity"

[[layers]]
id = "patina"
slot = "outer"
pattern = "patina"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[motifs.pier-outline]
art = "pier-outline"
gap = [129, 3]

[motifs.pier-light]
art = "pier-light"
gap = [129, 3]

[motifs.pier-cavity]
art = "pier-cavity"
gap = [129, 3]

[motifs.pier-hatch]
art = "pier-hatch"
gap = [129, 3]

[motifs.pier-face]
art = "pier-face"
gap = [129, 3]

[motifs.pier-shadow]
art = "pier-shadow"
gap = [129, 3]

[[layers]]
id = "piers-shadow"
slot = "outer"
motif = "pier-shadow"
offset = [1, 1]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "piers-outline"
slot = "outer"
motif = "pier-outline"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "piers-light"
slot = "outer"
motif = "pier-light"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "piers-cavity"
slot = "outer"
motif = "pier-cavity"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "piers-hatch"
slot = "outer"
motif = "pier-hatch"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "piers-face"
slot = "outer"
motif = "pier-face"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "mark"
slot = "outer"
art = "maker-mark"
offset = [10, 1]
mode = "transparent-cell"
repeat = false

[[layers]]
id = "hero-shadow"
slot = "outer"
art = "hero-shadow"
offset = [6, 4]
mode = "transparent-cell"
repeat = false

[[layers]]
id = "hero-outline"
slot = "outer"
art = "hero-outline"
offset = [5, 4]
mode = "transparent-cell"
repeat = false

[[layers]]
id = "hero-light"
slot = "outer"
art = "hero-light"
offset = [5, 4]
mode = "transparent-cell"
repeat = false

[[layers]]
id = "hero-cavity"
slot = "outer"
art = "hero-cavity"
offset = [5, 4]
mode = "transparent-cell"
repeat = false

[[layers]]
id = "hero-hatch"
slot = "outer"
art = "hero-hatch"
offset = [5, 4]
mode = "transparent-cell"
repeat = false

[[layers]]
id = "hero-face"
slot = "outer"
art = "hero-face"
offset = [5, 4]
mode = "transparent-cell"
repeat = false

[[layers]]
id = "divider-cavity"
slot = "divider"
art = "molding-cavity"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "divider-hatch"
slot = "divider"
art = "molding-hatch"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "divider-outline"
slot = "divider"
art = "molding-outline"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "divider-light"
slot = "divider"
art = "molding-light"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "edit-cavity"
slot = "tile.edit.chrome"
art = "molding-cavity"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "edit-hatch"
slot = "tile.edit.chrome"
art = "molding-hatch"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
