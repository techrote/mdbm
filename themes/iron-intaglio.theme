[[layers]]
id = "contents-light"
slot = "tile.contents.chrome"
art = "molding-light"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[rules]]
target = "layer.edit-outline"
states = ["focused"]
set = { style = "active" }

[[rules]]
target = "layer.view-outline"
states = ["focused"]
set = { style = "active" }

[[rules]]
target = "layer.filesystem-outline"
states = ["focused"]
set = { style = "active" }

[[rules]]
target = "layer.contents-outline"
states = ["focused"]
set = { style = "active" }

[[rules]]
target = "layer.edit-outline"
states = ["dirty"]
set = { style = "attention" }

[[rules]]
target = "layer.edit-outline"
cue = "save-success"
set = { style = "saved" }

[[rules]]
target = "layer.edit-outline"
cue = "save-failure"
set = { style = "fault" }

[[variants]]
when = { max_width = 119 }
hide_layers = ["hero-shadow", "hero-outline", "hero-light", "hero-cavity", "hero-hatch", "hero-face", "mark"]

[[variants]]
when = { high_contrast = true }
hide_layers = ["piers-shadow", "piers-outline", "piers-light", "piers-cavity", "piers-hatch", "piers-face", "hero-shadow", "hero-outline", "hero-light", "hero-cavity", "hero-hatch", "hero-face", "mark", "patina"]

[fallbacks.ascii]
# All drawings already use printable ASCII.
glyph = "."

[fallbacks.monochrome]
glyph = "."
# Preserve contours, hatch and counters; remove displaced shadows.
hide_layers = ["hero-shadow", "piers-shadow", "patina"]

[fallbacks.narrow]
glyph = "."
hide_layers = ["piers-shadow", "piers-outline", "piers-light", "piers-cavity", "piers-hatch", "piers-face", "hero-shadow", "hero-outline", "hero-light", "hero-cavity", "hero-hatch", "hero-face", "mark", "patina"]

[fallbacks.reduced_motion]
glyph = "."
# The entire relief remains static in all motion modes.
