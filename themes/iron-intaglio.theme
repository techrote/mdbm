repeat = true

[[layers]]
id = "filesystem-hatch"
slot = "tile.filesystem.chrome"
art = "molding-hatch"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "filesystem-outline"
slot = "tile.filesystem.chrome"
art = "molding-outline"
