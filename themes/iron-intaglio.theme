offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "view-cavity"
slot = "tile.view.chrome"
art = "molding-cavity"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "view-hatch"
slot = "tile.view.chrome"
art = "molding-hatch"
offset = [0, 0]
mode = "transparent-cell"
repeat = true

[[layers]]
id = "view-outline"
